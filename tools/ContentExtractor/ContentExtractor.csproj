<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RuntimeIdentifier>osx-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GameLibs>$(MSBuildThisFileDirectory)../../vendor/game/MacOS</GameLibs>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MonoGame.Framework"><HintPath>$(GameLibs)/MonoGame.Framework.dll</HintPath></Reference>
    <Reference Include="StardewValley.GameData"><HintPath>$(GameLibs)/StardewValley.GameData.dll</HintPath></Reference>
    <Reference Include="xTile"><HintPath>$(GameLibs)/xTile.dll</HintPath></Reference>
    <Reference Include="BmFont"><HintPath>$(GameLibs)/BmFont.dll</HintPath></Reference>
    <Reference Include="CPExtBmFont"><HintPath>$(GameLibs)/CPExtBmFont.dll</HintPath></Reference>
  </ItemGroup>
</Project>
