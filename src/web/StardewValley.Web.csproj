<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    M4: the same sources again, this time on KNI's Blazor/WebGL platform.
    Only the platform package differs from the desktop build - KNI ships
    Kni.Platform.SDL2.GL and Kni.Platform.Blazor.GL at the same version.

    No AOT yet. The goal is to boot; interpreted WASM gets there without the
    emscripten toolchain and iterates far faster.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <RootNamespace>StardewValley.Web</RootNamespace>
    <!-- The decompiled tree carries its own Properties/AssemblyInfo.cs. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The decompiled tree also has a Main; the browser needs ours. -->
    <StartupObject>StardewValley.Web.WebProgram</StartupObject>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);KNI;WEB</DefineConstants>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0169;CS0219;CS0414;CS0618;CS0649;CS0672;CS1717;CS8509;CS8632;CS8981;SYSLIB0011;SYSLIB0051;CA1416;CA2022;CA2200;BL0007</NoWarn>
    <GameLibs>$(MSBuildThisFileDirectory)../../vendor/game/MacOS</GameLibs>
    <Decompiled>$(MSBuildThisFileDirectory)../decompiled/StardewValley</Decompiled>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(Decompiled)/**/*.cs" Exclude="$(Decompiled)/obj/**/*.cs;$(Decompiled)/bin/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../platform/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" />
    <EmbeddedResource Include="$(Decompiled)/StardewValley.Icon.ico" LogicalName="StardewValley.Icon.ico" />
    <EmbeddedResource Include="$(Decompiled)/StardewValley.Icon.bmp" LogicalName="StardewValley.Icon.bmp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.11" PrivateAssets="all" />
    <PackageReference Include="nkast.Xna.Framework" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Storage" Version="4.3.9001" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.3.9001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../compat/MonoGame.Framework.Facade.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="StardewValley.GameData"><HintPath>$(GameLibs)/StardewValley.GameData.dll</HintPath></Reference>
    <Reference Include="xTile"><HintPath>$(GameLibs)/xTile.dll</HintPath></Reference>
    <Reference Include="Lidgren.Network"><HintPath>$(GameLibs)/Lidgren.Network.dll</HintPath></Reference>
    <Reference Include="BmFont"><HintPath>$(GameLibs)/BmFont.dll</HintPath></Reference>
    <Reference Include="SkiaSharp"><HintPath>$(GameLibs)/SkiaSharp.dll</HintPath></Reference>
    <Reference Include="TextCopy"><HintPath>$(GameLibs)/TextCopy.dll</HintPath></Reference>
    <Reference Include="Steamworks.NET"><HintPath>$(GameLibs)/Steamworks.NET.dll</HintPath></Reference>
    <Reference Include="GalaxyCSharp"><HintPath>$(GameLibs)/GalaxyCSharp.dll</HintPath></Reference>
    <Reference Include="System.Data.HashFunction.Core"><HintPath>$(GameLibs)/System.Data.HashFunction.Core.dll</HintPath></Reference>
    <Reference Include="System.Data.HashFunction.Interfaces"><HintPath>$(GameLibs)/System.Data.HashFunction.Interfaces.dll</HintPath></Reference>
    <Reference Include="System.Data.HashFunction.xxHash"><HintPath>$(GameLibs)/System.Data.HashFunction.xxHash.dll</HintPath></Reference>
  </ItemGroup>
</Project>
